# ============================================================================
# 生产源镜像环境变量模板
# 复刻新实例流程：
#   1) cp .env.example .env
#   2) ./scripts/bootstrap.sh        # 自动把所有 __GEN__ 替换为本实例独立强密钥，并渲染 proxysql.cnf
#   3) docker compose up -d
# 标记为 __GEN__ 的项会被 bootstrap 生成；其余按需修改。
# ============================================================================

# ===== 应用 =====
APP_ENV=production
APP_DEBUG=false
# 严格白名单：生产必须填具体域名（同源前端经 nginx 反代不触发 CORS）
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
# 对外站点根地址（短链/账号摘要/模拟登录等拼接 URL）
PUBLIC_WEB_BASE_URL=https://your-domain.com

# ===== 密钥（由 scripts/bootstrap.sh 自动生成，每实例独立）=====
JWT_SECRET_KEY=__GEN__
INTERNAL_TOKEN=__GEN__
TELEGRAM_STAFF_API_SECRET=__GEN__
BOT_PERSISTENCE_KEY=__GEN__

# ===== 数据库 =====
MYSQL_USER=smsuser
MYSQL_PASSWORD=__GEN__
MYSQL_ROOT_PASSWORD=__GEN__
MYSQL_DATABASE=sms_system

# ===== Redis =====
REDIS_PASSWORD=__GEN__
REDIS_MAXMEMORY=1gb
REDIS_MAXMEMORY_POLICY=volatile-lru

# ===== RabbitMQ =====
RABBITMQ_USER=smsc_mq
RABBITMQ_PASSWORD=__GEN__

# ===== ProxySQL（proxysql.cnf 由 bootstrap 从 proxysql.cnf.template 渲染）=====
PROXYSQL_ADMIN_PASSWORD=__GEN__
PROXYSQL_RADMIN_PASSWORD=__GEN__
PROXYSQL_MONITOR_PASSWORD=__GEN__

# ===== Grafana =====
GRAFANA_ADMIN_PASSWORD=__GEN__

# ============================================================================
# MySQL 生产调优（基准 16GB/8 线程主机；更大配置的实例请上调 buffer pool/并发）
# ============================================================================
INNODB_BUFFER_POOL_SIZE=6G
INNODB_BUFFER_POOL_INSTANCES=6
INNODB_LOG_BUFFER_SIZE=64M
INNODB_REDO_LOG_CAPACITY=2147483648
INNODB_FLUSH_LOG_AT_TRX_COMMIT=2
SYNC_BINLOG=1000
INNODB_IO_CAPACITY=2000
INNODB_IO_CAPACITY_MAX=4000
MYSQL_MAX_CONNECTIONS=1000

# ===== Celery worker 并发与内存回收（16GB/8 线程基准）=====
SMS_WORKER_CONCURRENCY=8
SMS_WORKER_MAX_TASKS_PER_CHILD=500
RESULT_WORKER_CONCURRENCY=4
RESULT_WORKER_MAX_TASKS_PER_CHILD=500
DLR_WORKER_CONCURRENCY=4
DLR_WORKER_MAX_TASKS_PER_CHILD=500
WORKER_CONCURRENCY=4
WORKER_MAX_TASKS_PER_CHILD=500
WEB_WORKER_MAX_TASKS_PER_CHILD=500

# ===== sms_logs 分区保留（月）=====
SMS_LOGS_RETAIN_MONTHS=3

# ===== 外部集成 =====
# OKCC 语音账户同步（默认关闭）
OKCC_BEAT_SYNC_ENABLED=false
# Telegram Bot（如启用）
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_CS_FALLBACK_URL=https://t.me/your_sales

# ===== SMPP 网关 =====
SMPP_SUBMIT_RESP_WAIT_SECONDS=8
# SMPP_DLR_SOCKET_HOLD_SECONDS=300
# DLR_SENT_TIMEOUT_HOURS=72
# SMPP_GATEWAY_WORKERS=8
# SMPP_GATEWAY_PREFETCH=64
# 通道真实 bind 探测（两端同串）
# SMPP_PROBE_TOKEN=__GEN__
# SMPP_GATEWAY_PROBE_URL=http://smpp-gateway:8090
# SMPP_PROBE_BIND_LISTEN=:8090

# ===== 语音模块（可选）=====
# VOS_HTTP_VERIFY_SSL=true
